# ============================================================
# Smart PMO Agent — Environment Configuration
# Copy this file to .env and fill in values as needed.
# Default values run fully offline using local demo data.
# ============================================================

# --- Application ---
APP_ENV=local
LOG_LEVEL=INFO

# --- PMO Data Source ---
# "mock"       = load local Monday-style demo data (default, no account needed)
# "monday_api" = future live Monday.com integration (requires token below)
PMO_DATA_SOURCE=mock

# --- Monday API (future extension — leave empty in v1) ---
MONDAY_API_TOKEN=
MONDAY_WORKSPACE_ID=

# --- AI / Embedding provider for PMO Q&A ---
# Options: mock | huggingface | openai | gemini
# Default: mock (no API key required, smart rule-based responses)
MOCK_MODE=true
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=mock-384

# --- Vector store for methodology doc indexing ---
# Options: chroma | faiss
VECTOR_STORE=chroma

# --- Chunking for methodology docs ---
# Options: recursive | fixed
CHUNK_STRATEGY=recursive
CHUNK_SIZE=500
CHUNK_OVERLAP=100

# --- Retrieval ---
TOP_K=5

# --- Optional AI provider keys ---
# Add OPENAI_API_KEY to enable full AI-powered PMO Q&A responses
# Leave empty to use smart mock/demo responses (fully functional offline)
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- Paths ---
DATA_DIR=data
MONDAY_DEMO_DIR=data/monday_demo
METHODOLOGY_DOCS_DIR=data/methodology_docs
VECTOR_DB_DIR=vector_db
RESULTS_DIR=results

# --- Upload limits ---
MAX_UPLOAD_MB=10
