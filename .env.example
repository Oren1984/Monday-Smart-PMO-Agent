# Data source mode
# mock = local demo data
# monday_api = future live Monday API integration
PMO_DATA_SOURCE=mock

# Monday API - future live integration
MONDAY_API_TOKEN=
MONDAY_WORKSPACE_ID=

# AI provider - optional
OPENAI_API_KEY=
GEMINI_API_KEY=

# Embeddings
# mock / huggingface / openai / gemini
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=

# App defaults
MOCK_MODE=true


